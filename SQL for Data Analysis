-- 3. SELECT: show all orders
SELECT * FROM orders;

-- 4. WHERE: orders above 10,000
SELECT order_id, amount, order_date FROM orders WHERE amount > 10000;

-- 5. ORDER BY: highest order amount first
SELECT order_id, amount FROM orders ORDER BY amount DESC;

-- 6. GROUP BY and SUM: revenue by product
SELECT p.product_name, SUM(o.amount) AS total_revenue
FROM orders o INNER JOIN products p ON o.product_id = p.product_id
GROUP BY p.product_id, p.product_name
ORDER BY total_revenue DESC;

-- 7. Aggregate functions: total revenue, average order amount, order count
SELECT SUM(amount) AS total_revenue,
       ROUND(AVG(amount), 2) AS average_order_amount,
       COUNT(*) AS number_of_orders
FROM orders;

-- 8. INNER JOIN: order, customer and product details
SELECT o.order_id, c.customer_name, p.product_name, o.quantity, o.amount, o.order_date
FROM orders o
INNER JOIN customers c ON o.customer_id = c.customer_id
INNER JOIN products p ON o.product_id = p.product_id
ORDER BY o.order_id;

-- 9. LEFT JOIN: all customers, even if they have no orders
SELECT c.customer_id, c.customer_name, c.city,
       COUNT(o.order_id) AS number_of_orders,
       COALESCE(SUM(o.amount), 0) AS total_spent
FROM customers c LEFT JOIN orders o ON c.customer_id = o.customer_id
GROUP BY c.customer_id, c.customer_name, c.city
ORDER BY total_spent DESC;

-- 10. RIGHT JOIN concept for SQLite: use products as the preserved table
-- and LEFT JOIN orders, showing products even when they have no orders.
SELECT p.product_id, p.product_name,
       COUNT(o.order_id) AS number_of_orders,
       COALESCE(SUM(o.amount), 0) AS total_revenue
FROM products p LEFT JOIN orders o ON p.product_id = o.product_id
GROUP BY p.product_id, p.product_name
ORDER BY total_revenue DESC;

-- 11. Subquery: customers whose spending is above the average customer spending
SELECT customer_name, total_spent
FROM (
    SELECT c.customer_id, c.customer_name, SUM(o.amount) AS total_spent
    FROM customers c JOIN orders o ON c.customer_id = o.customer_id
    GROUP BY c.customer_id, c.customer_name
) AS customer_totals
WHERE total_spent > (
    SELECT AVG(customer_spend)
    FROM (
        SELECT SUM(amount) AS customer_spend
        FROM orders
        GROUP BY customer_id
    ) AS average_spend
);

-- 12. Create a reusable analysis view
CREATE VIEW sales_summary AS
SELECT c.customer_name, c.city, p.product_name, p.category,
       o.order_id, o.quantity, o.amount, o.order_date
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
JOIN products p ON o.product_id = p.product_id;

-- Analyze revenue by category using the view
SELECT category, SUM(amount) AS category_revenue,
       ROUND(AVG(amount), 2) AS average_order_amount
FROM sales_summary
GROUP BY category
ORDER BY category_revenue DESC;

